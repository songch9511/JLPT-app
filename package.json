{
  "name": "jlpt-ruma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "data": "node scripts/build-data.mjs --extras",
    "ios:sync": "npm run build:native && cap sync ios",
    "ios:assets": "node scripts/ios/make-assets.mjs",
    "ios:set-id": "node scripts/ios/set-bundle-id.mjs",
    "theme": "node scripts/build-theme.mjs",
    "astryx": "astryx"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.15",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@capawesome/capacitor-file-picker": "8.1.1",
    "@stylexjs/stylex": "0.19.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.15",
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
